# Token MCP do Ekyte (Cadastro → Configurações no eKyte).
# Sem aspas. Só o valor, ou a URL completa com ?token=
EKYTE_MCP_TOKEN=

# Opcional — Cockpit FLOW (catálogo ticker → gerência/coord).
# Sem isso o painel usa data/flow-tickers.json.
FLOW_MCP_JWT=
FLOW_MCP_GATEWAY=

# Opcional — MCP ekyte-colli (localize_project). Só se você já tiver.
EKYTE_COLLI_URL=
EKYTE_COLLI_TOKEN=
